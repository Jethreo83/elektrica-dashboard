# .env.example — copy to .env and fill in real values. NEVER commit .env.
# Root repo env (backend). See web/.env.example for the frontend's own file.

# Neon Postgres connection string. IMPORTANT: check `env | grep -i DATABASE`
# before trusting this file -- dotenv (via scripts/run_dev_server.py's
# load_dotenv(override=True)) DOES override an already-exported env var
# here, but a bare `uvicorn app.api:app` does NOT load .env at all, so a
# stale exported DATABASE_URL from another project's shell session can
# silently win. This exact mistake pointed a session at the WRONG Neon
# branch once already in this project -- always verify with
# `neon branches list --project-id aged-art-92489373` and a
# `SELECT current_database()`-style sanity check before writing.
#
# Staging branch (safe to test against): br-broad-hat-a5uyz6he
# Production branch (NEVER touch from dev/test): br-dawn-resonance-a5xfpgqv
DATABASE_URL=postgresql://neondb_owner:PASSWORD@ep-bold-leaf-a5dr4amg.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Name of the env var holding the connection string above -- lets you
# swap between a plain and a SET ROLE'd connection without code changes.
ELEKTRICA_DB_ENV_VAR=DATABASE_URL

# Optional: SET ROLE target after connecting (e.g. elektrica_app) to
# exercise the app layer under least-privilege grants instead of
# neondb_owner. Leave unset for local dev unless specifically testing
# grant boundaries.
# ELEKTRICA_DB_SET_ROLE=elektrica_app

# Shared-secret SSO JWT (shell-dashboard's JWT_CONTRACT.md). MUST match
# the value configured in shell-dashboard/api/.env and every other
# dashboard backend's JWT_SECRET -- rotate by coordinating a redeploy
# of all four services, never silently.
JWT_SECRET=CHANGE_ME_SHARED_ACROSS_ALL_DASHBOARDS

# API key for the one intentionally machine-to-machine route,
# POST /rentals/{id}/proposals. Unset -> that route returns 503
# (disabled), not silently open.
ELEKTRICA_BOT_API_KEY=CHANGE_ME

# Comma-separated CORS allowlist for the frontend dev servers. Defaults
# to the four pinned local ports (shell=5173, vls=5180, elektrica=5181,
# collision=5182) if unset.
ELEKTRICA_CORS_ORIGINS=http://localhost:5173,http://localhost:5180,http://localhost:5181,http://localhost:5182

# Port scripts/run_dev_server.py listens on. 8001, NOT FastAPI's
# default 8000 -- avoids a collision with the Complete Collision
# dashboard's backend, which also runs on localhost during parallel dev.
PORT=8001
